<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>QuayTools</AssemblyName>
    <RootNamespace>QuayTools</RootNamespace>
    <AssemblyVersion>0.1.6.0</AssemblyVersion>
    <FileVersion>0.1.6.0</FileVersion>
    <LangVersion>7.3</LangVersion>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>

    <!-- Path to the game's Managed folder. Override with: dotnet build -p:CS1ManagedPath="..." -->
    <CS1ManagedPath Condition="'$(CS1ManagedPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Cities_Skylines\Cities_Data\Managed</CS1ManagedPath>

    <!-- Where the mod gets copied after build (local mods folder) -->
    <ModDeployDir Condition="'$(ModDeployDir)' == ''">$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Addons\Mods\QuayTools</ModDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

    <!-- CitiesHarmony.API is shipped with the mod (it loads Harmony from the "Harmony (Mod Dependency)" mod).
         CitiesHarmony.Harmony is compile-only: the runtime 0Harmony.dll comes from that mod, never from our folder. -->
    <PackageReference Include="CitiesHarmony.API" Version="2.*" />
    <PackageReference Include="CitiesHarmony.Harmony" Version="2.*" ExcludeAssets="runtime" PrivateAssets="all" />

    <Reference Include="Assembly-CSharp">
      <HintPath>$(CS1ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ICities">
      <HintPath>$(CS1ManagedPath)\ICities.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(CS1ManagedPath)\ColossalManaged.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CS1ManagedPath)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- UnifiedUI helper library (MIT). Must be shipped next to QuayTools.dll. -->
    <Reference Include="UnifiedUILib">
      <HintPath>Lib\UnifiedUILib.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <ModDll Include="$(TargetDir)QuayTools.dll" />
      <ModDll Include="$(TargetDir)UnifiedUILib.dll" />
      <ModDll Include="$(TargetDir)CitiesHarmony.API.dll" />
      <ModIcon Include="$(MSBuildProjectDirectory)\Icons\*.png" />
    </ItemGroup>
    <MakeDir Directories="$(ModDeployDir);$(ModDeployDir)\Icons" />
    <Copy SourceFiles="@(ModDll)" DestinationFolder="$(ModDeployDir)" />
    <Copy SourceFiles="@(ModIcon)" DestinationFolder="$(ModDeployDir)\Icons" />
    <Message Importance="high" Text="QuayTools deployed to $(ModDeployDir)" />
  </Target>

</Project>
